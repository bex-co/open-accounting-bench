{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Accounting Bench dataset manifest",
  "type": "object",
  "required": ["dataset", "version", "tasks"],
  "properties": {
    "dataset": {"type": "string"},
    "version": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id", "family", "seed", "generator_version",
          "track", "category", "framework", "level", "format", "skill",
          "standards", "digest"
        ],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "family": {"type": "string"},
          "seed": {"type": "integer"},
          "generator_version": {"type": "string"},
          "track": {"enum": ["stable", "dynamic", "holdout"]},
          "category": {"enum": ["financial-accounting", "management-accounting", "tax", "audit-assurance"]},
          "framework": {"enum": ["core", "ifrs", "us-gaap"]},
          "level": {"enum": ["vocational", "university", "professional"]},
          "format": {"enum": ["journal-entry", "single-choice", "multiple-choice", "numeric", "open-text"]},
          "skill": {"enum": ["remembering-understanding", "application", "analysis", "evaluation"]},
          "standards": {
            "type": "array",
            "items": {"type": "string", "pattern": "^(asc|ias|ifrs|ifric):[0-9]+(-[0-9]+)*$"},
            "uniqueItems": true
          },
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
